<Application x:Class="LtAmpDotNet.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LtAmpDotNet.Gui"
             xmlns:selectors="clr-namespace:LtAmpDotNet.Gui.Selectors"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate x:Key="ValueTemplate" >
            <TextBlock Text="{Binding CurrentValue, StringFormat={}{0:F2}}" Margin="5,0,0,0" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
        </DataTemplate>
        <DataTemplate x:Key="SliderTemplate">
            <Slider Value="{Binding CurrentValue}" Minimum="0" Maximum="1" Ticks="{Binding Interval}" IsSnapToTickEnabled="True" Width="200" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
        </DataTemplate>
        <DataTemplate x:Key="ComboBoxTemplate">
            <ComboBox ItemsSource="{Binding ListItems}" SelectedValue="{Binding CurrentValue}" Width="200" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
        </DataTemplate>
        <DataTemplate x:Key="CheckBoxTemplate">
            <CheckBox IsChecked="{Binding CurrentValue}" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
        </DataTemplate>

        <selectors:ParameterTemplateSelector x:Key="ParameterTemplateSelector" x:Name="_"
                                             ValueTemplate="{StaticResource ValueTemplate}"
                                             SliderTemplate="{StaticResource SliderTemplate}"
                                             ComboBoxTemplate="{StaticResource ComboBoxTemplate}"
                                             CheckBoxTemplate="{StaticResource CheckBoxTemplate}"/>
    </Application.Resources>
</Application>
